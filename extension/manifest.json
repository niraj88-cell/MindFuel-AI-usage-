{
  "manifest_version": 3,
  "name": "SatyaShift — Verified Focus",
  "version": "2.9.2",
  "description": "Proof you did the work. Counts time per site — only the domain, never the page — and gently checks in when attention drifts.",
  "permissions": [
    "storage",
    "tabs",
    "alarms",
    "cookies",
    "idle",
    "notifications"
  ],
  "host_permissions": [
    "http://localhost:3000/*",
    "https://satyashift.vercel.app/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://satyashift.vercel.app/*",
        "http://localhost:3000/*"
      ],
      "js": ["bridge.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "SatyaShift",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
